{
  "id": "fakeapp",
  "version": 1,
  "display_name": "Fake app",
  "description": "A connector with no real app behind it, for the host's and the gate's tests.",
  "connection_levels": [
    "personal"
  ],
  "auth": {
    "credential_modes": [
      "user_key"
    ],
    "user_key": {
      "fields": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ]
      },
      "inject": {
        "header": "Authorization",
        "value": "Bearer {key}"
      }
    }
  },
  "base_url": "https://api.fakeapp.example.com",
  "egress_allowlist": [
    "api.fakeapp.example.com"
  ],
  "tools": [
    {
      "name": "fakeapp.echo",
      "effect": "read",
      "description": "Echo a short text back. Use when a test needs a tool call that always succeeds.",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "fakeapp.get_note",
      "effect": "read",
      "description": "Fetch one note by its id. Use when a test needs a read tool that can fail with not_found.",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "fakeapp.add_note",
      "effect": "write",
      "description": "Add a note with the given text. Use when a test needs a tool whose call is a POST and so a write.",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  ],
  "streams": [
    {
      "name": "notes",
      "modes": [
        "full",
        "incremental"
      ],
      "schedule": "rate(15 minutes)",
      "deletes": "feed",
      "document": {
        "title": "/title",
        "body": "/body"
      }
    }
  ],
  "reauth_on": [
    401
  ]
}