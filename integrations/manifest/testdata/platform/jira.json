              "null"
            ],
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "read:jira-work",
        "write:jira-work"
      ],
      "token_kind": "default"
    },
    {
      "name": "jira.assign_issue",
      "description": "Assign an issue to a person (an account id from find_user), or unassign it with account_id null. When the issue already has that assignee nothing is written and nobody is notified again (changed is false).",
      "effect": "write",
      "input_schema": {
        "type": "object",
        "required": [
          "key",
          "account_id"
        ],
        "properties": {
          "key": {
