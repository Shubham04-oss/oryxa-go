        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "key",
          "transition_id",
          "status"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}-[0-9]{1,18}$"
          },
          "transition_id": {
            "type": "integer"
          },
          "status": {
            "type": [
