      ],
      "token_kind": "default"
    },
    {
      "name": "jira.list_transitions",
      "description": "List the status changes available on an issue right now (e.g. Start progress -> In Progress, Done), with their ids and target status. Always call it before transition_issue: transition ids differ per workflow and depend on the current status.",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}-[0-9]{1,18}$",
            "description": "Issue key, e.g. OPS-123."
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "transitions"
        ],
        "properties": {
          "transitions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "to"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string",
                  "maxLength": 255
                },
                "to": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 255
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "read:jira-work"
      ],
      "token_kind": "default"
    },
    {
      "name": "jira.transition_issue",
      "description": "Move an issue to another status with a transition id from list_transitions. If that transition is not available any more (for example the issue already moved), nothing changes and the error says the current status: check it rather than retrying. Transitions whose screen has required fields are refused by Jira.",
      "effect": "write",
      "input_schema": {
        "type": "object",
        "required": [
          "key",
          "transition_id"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}-[0-9]{1,18}$",
            "description": "Issue key, e.g. OPS-123."
          },
          "transition_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999
          }
