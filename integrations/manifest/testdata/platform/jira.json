  "streams": [
    {
      "name": "issues",
      "modes": [
        "full",
        "incremental",
        "webhook"
      ],
      "track_deletes": true,
      "schedule": "rate(15 minutes)"
    },
    {
      "name": "project_access",
      "modes": [
        "full"
      ],
      "acl": true,
      "schedule": "rate(6 hours)"
    }
  ],
  "webhooks": {
    "ingress": "per_provider",
    "verification": {
      "scheme": "jwt",
      "header": "Authorization"
    },
    "replay_window_s": 300,
    "routing": [
      "/matchedWebhookIds"
    ],
    "routing_per_site": true,
    "subscription": {
      "max_ttl_s": 2592000,
      "renew_at": 0.6
    },
    "fallback_poll_s": 900
  },
  "reauth_on": [
    "invalid_grant",
    "unauthorized_client"
  ]
