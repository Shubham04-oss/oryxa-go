{
  "id": "gdrive",
  "version": 1,
  "display_name": "Google Drive",
  "description": "Search and read files in Google Drive.",
  "connection_levels": ["personal", "workspace"],
  "auth": {
    "credential_modes": ["platform", "tenant_app"],
    "oauth2": {
      "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "revoke_url": "https://oauth2.googleapis.com/revoke",
      "pkce": true,
      "authorization_params": { "access_type": "offline", "prompt": "consent", "include_granted_scopes": "true" },
      "token_kinds": [
        {
          "name": "default",
          "personal_grant": true,
          "scopes": [
            "https://www.googleapis.com/auth/drive.readonly",
            "https://www.googleapis.com/auth/admin.directory.group.member.readonly"
          ]
        },
        {
          "name": "write",
          "optional": true,
          "scopes": [
            "https://www.googleapis.com/auth/drive.file"
          ]
        },
        {
          "name": "comment",
          "optional": true,
          "scopes": [
            "https://www.googleapis.com/auth/drive"
          ]
        }
      ],
      "refresh": { "ahead_seconds": 300, "rotates": false }
    }
  },
  "base_url": "https://www.googleapis.com",
  "egress_allowlist": ["accounts.google.com", "oauth2.googleapis.com", "www.googleapis.com", "admin.googleapis.com"],
  "verify": { "path": "/drive/v3/about?fields=user", "token_kind": "default" },
  "rate_limit": { "max_concurrency": 8, "retry_headers": ["Retry-After"] },
  "tools": [
    {
      "name": "gdrive.search_files",
      "description": "Find Drive files (My Drive and shared drives) whose name or content contains the given words. Use it first whenever you need a file and have no file id. Pass plain words or a phrase, not Drive query syntax: the text is matched as one full-text phrase and escaped, so quotes, `name contains` or `in parents` have no special meaning. Trashed files are excluded. Returns names and links, not contents: follow with read_file.",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Words or a phrase to look for in file names and contents."
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 10
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "files"
        ],
        "properties": {
          "files": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "mime_type",
                "url",
                "modified"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,256}$"
                },
                "name": {
                  "type": "string",
                  "maxLength": 512
                },
                "mime_type": {
                  "type": "string",
                  "maxLength": 255
                },
                "url": {
                  "type": "string",
                  "maxLength": 512
                },
                "modified": {
                  "type": "string",
                  "maxLength": 40,
                  "description": "RFC 3339 last-modified time; empty when Drive gives none."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "https://www.googleapis.com/auth/drive.readonly"
      ],
      "token_kind": "default"
    },
    {
      "name": "gdrive.read_file",
      "description": "Read a file's text by file id: Google Docs as markdown, Sheets as CSV (first sheet only, as Google exports it), Slides as plain text, and plain-text, markdown, CSV or JSON uploads as they are. Text past 100 KB is cut and `truncated` is true. PDFs, images and other binaries cannot be read: use get_file for their details. Use after search_files or list_folder when you need the contents.",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "required": [
          "file_id"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,256}$",
            "description": "A Drive file id, from search_files, list_folder or a Drive link (the part after /d/)."
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mime_type",
          "text",
          "truncated"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,256}$"
          },
          "name": {
            "type": "string",
            "maxLength": 512
          },
          "mime_type": {
            "type": "string",
            "maxLength": 255,
            "description": "The format of `text`: text/markdown, text/csv, text/plain or the upload's own type."
          },
          "text": {
            "type": "string",
            "maxLength": 100000
          },
          "truncated": {
            "type": "boolean",
            "description": "True when the file was longer than 100 KB and `text` holds only the start."
          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "https://www.googleapis.com/auth/drive.readonly"
      ],
      "token_kind": "default"
    },
    {
      "name": "gdrive.get_file",
      "description": "Get one file's details (name, type, link, parent folder, shared drive, last change, whether it is trashed) when you have its id. Use it to check what a file is or where it lives; use read_file for its contents and who_has_access for its sharing.",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "required": [
          "file_id"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,256}$",
            "description": "A Drive file id, from search_files, list_folder or a Drive link (the part after /d/)."
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mime_type",
          "url",
          "modified",
          "parent_id",
          "drive_id",
          "trashed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,256}$"
          },
          "name": {
            "type": "string",
            "maxLength": 512
          },
          "mime_type": {
            "type": "string",
            "maxLength": 255
          },
          "url": {
            "type": "string",
            "maxLength": 512
          },
          "modified": {
            "type": "string",
            "maxLength": 40,
            "description": "RFC 3339 last-modified time; empty when Drive gives none."
          },
          "parent_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{0,256}$",
            "description": "The containing folder; empty when Drive does not say."
          },
          "drive_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{0,256}$",
            "description": "The shared drive; empty for My Drive."
          },
          "trashed": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "https://www.googleapis.com/auth/drive.readonly"
      ],
      "token_kind": "default"
    },
    {
      "name": "gdrive.list_folder",
      "description": "List what is directly inside one folder or shared drive (not the contents of its subfolders), most recently changed first, trashed items excluded. Use when the user points at a folder, or to browse after search_files finds one; a shared drive id from list_shared_drives works as a folder id. Subfolders have mime_type application/vnd.google-apps.folder.",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "required": [
          "folder_id"
        ],
        "properties": {
          "folder_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,256}$",
            "description": "A folder id, or a shared drive id."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "files"
        ],
        "properties": {
          "files": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "mime_type",
                "url",
                "modified"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,256}$"
                },
                "name": {
                  "type": "string",
                  "maxLength": 512
                },
                "mime_type": {
                  "type": "string",
                  "maxLength": 255
                },
                "url": {
                  "type": "string",
                  "maxLength": 512
                },
                "modified": {
                  "type": "string",
                  "maxLength": 40,
                  "description": "RFC 3339 last-modified time; empty when Drive gives none."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "https://www.googleapis.com/auth/drive.readonly"
      ],
      "token_kind": "default"
    },
    {
      "name": "gdrive.list_shared_drives",
      "description": "List the shared drives the user is a member of (up to 100). Use to find a team's drive by name, then list_folder with its id. `truncated` is true when the user belongs to more.",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "drives",
          "truncated"
        ],
        "properties": {
          "drives": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,256}$"
                },
                "name": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "additionalProperties": false
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "https://www.googleapis.com/auth/drive.readonly"
      ],
      "token_kind": "default"
    },
    {
      "name": "gdrive.who_has_access",
      "description": "Show who can open a file and with which role, before you quote or share its contents. Grants are people (`user`), Google groups (`group`), everyone in a domain (`domain`) or anyone (`anyone`), inherited ones included. For `domain` and `anyone`, `discoverable: false` means link-only: only people who have the link can open it, and it does not appear in their searches. Oryxa itself treats a discoverable `anyone` grant as readable by anyone in the tenant, never the public. Up to 100 grants; `truncated` is true when there are more.",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "required": [
          "file_id"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,256}$",
            "description": "A Drive file id, from search_files, list_folder or a Drive link (the part after /d/)."
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "grants",
          "truncated"
        ],
        "properties": {
          "grants": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "type",
                "role"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "user",
                    "group",
                    "domain",
                    "anyone"
                  ]
                },
                "role": {
                  "type": "string",
                  "maxLength": 32,
                  "description": "owner, organizer, fileOrganizer, writer, commenter or reader."
                },
                "email": {
                  "type": "string",
                  "maxLength": 320
                },
                "domain": {
                  "type": "string",
                  "maxLength": 255
                },
                "discoverable": {
                  "type": "boolean",
                  "description": "Only on domain and anyone grants: false means link-only."
                }
              },
              "additionalProperties": false
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "https://www.googleapis.com/auth/drive.readonly"
      ],
      "token_kind": "default"
    },
    {
      "name": "gdrive.create_document",
      "description": "Create a new Google Doc from plain text and return its link. Use only when the user asks for a document to be written or saved to Drive; it never edits an existing file. Needs the optional Drive write permission (drive.file: only files Oryxa creates). Without folder_id the Doc lands in the user's My Drive. With folder_id, drive.file only allows folders Oryxa itself created; other folders fail as forbidden.",
      "effect": "write",
      "input_schema": {
        "type": "object",
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "text": {
            "type": "string",
            "maxLength": 200000,
            "description": "The document body as plain text; markdown syntax stays literal."
          },
          "folder_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,256}$",
            "description": "Optional destination folder; see the tool description for which folders work."
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,256}$"
          },
          "url": {
            "type": "string",
            "maxLength": 512
          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "https://www.googleapis.com/auth/drive.file"
      ],
      "token_kind": "write"
    },
    {
      "name": "gdrive.comment_on_file",
      "description": "Add a comment to a file. Use only when the user asks to comment on a file. Needs the optional Drive comment permission (full Drive access), which the user turns on separately; without it the call fails with no_token. Everyone who can open the file sees the comment and Google may email its owners, including people outside the company when the file is shared externally: check who_has_access first when that matters.",
      "effect": "external",
      "input_schema": {
        "type": "object",
        "required": [
          "file_id",
          "text"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,256}$",
            "description": "A Drive file id, from search_files, list_folder or a Drive link (the part after /d/)."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "comment_id"
        ],
        "properties": {
          "comment_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,256}$"
          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "https://www.googleapis.com/auth/drive"
      ],
      "token_kind": "comment"
    }
  ],
  "streams": [
    { "name": "files", "modes": ["full", "incremental", "webhook"], "track_deletes": true, "schedule": "rate(30 minutes)" },
    { "name": "permissions", "modes": ["full", "incremental"], "acl": true },
    { "name": "groups", "modes": ["full"], "acl": true, "schedule": "rate(6 hours)" }
  ],
  "webhooks": {
    "ingress": "per_connection",
    "verification": { "scheme": "channel_token", "header": "X-Goog-Channel-Token" },
    "route_header": "X-Goog-Channel-ID",
    "delivery_id_header": "X-Goog-Message-Number",
    "subscription": { "max_ttl_s": 604800, "renew_at": 0.6 },
    "fallback_poll_s": 1800
  },
  "reauth_on": ["invalid_grant"]
}
