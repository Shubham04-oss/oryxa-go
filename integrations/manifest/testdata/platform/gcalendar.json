          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "https://www.googleapis.com/auth/calendar.events"
      ]
    },
    {
      "name": "gcalendar.schedule_meeting",
      "description": "Create a meeting and email invitations to the attendees, optionally with a Google Meet link. Use when the user wants to meet with others; confirm the time first (suggest_meeting_times helps).",
      "effect": "external",
      "input_schema": {
        "type": "object",
        "required": [
          "summary",
          "start",
          "end",
          "attendees"
        ],
        "properties": {
          "calendar_id": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^(primary|[A-Za-z0-9._%+#-]{1,200}@[A-Za-z0-9.-]{1,200})$",
            "description": "`primary`, or a calendar id from list_calendars (people's calendars are their email).",
