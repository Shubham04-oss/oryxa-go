                "optional",
                "organizer",
                "self",
                "resource"
              ],
              "properties": {
                "email": {
                  "type": "string"
                },
                "response_status": {
                  "type": "string",
                  "enum": [
                    "needsAction",
                    "declined",
                    "tentative",
                    "accepted"
                  ]
                },
                "optional": {
                  "type": "boolean"
                },
                "organizer": {
                  "type": "boolean"
                },
                "self": {
                  "type": "boolean"
                },
                "resource": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "html_link": {
            "type": "string"
          },
          "meet_link": {
            "type": "string"
          },
          "recurring_event_id": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "default",
              "public",
