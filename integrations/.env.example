INTEGRATIONS_ADDRESS=:8082
AWS_REGION=ap-south-1
DATABASE_URL=postgresql://oryxa:change-me@postgres:5432/oryxa?sslmode=disable
# Enable after the database image/control plane has installed all four.
# POSTGRES_REQUIRED_EXTENSIONS=ltree,pg_trgm,vector,age
DEPLOYMENT_ENVIRONMENT=development
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_example
COGNITO_CLIENT_ID=replace-me
INTEGRATIONS_PUBLIC_BASE_URL=https://connect.example.com
INTEGRATIONS_RETURN_URLS=https://app.example.com
INTEGRATIONS_DYNAMO_TABLE=oryxa-integrations
INTEGRATIONS_WEBHOOK_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/oryxa-integrations-webhooks
INTEGRATIONS_PIECE_RUNNER_FUNCTION=oryxa-integrations-piece-runner
INTEGRATIONS_KMS_KEY_ID=alias/oryxa-integrations
EVENT_BUS_NAME=default
INTEGRATIONS_AUTO_MIGRATE=true
# Optional. Required to create Google new-email watches.
# GOOGLE_GMAIL_PUBSUB_TOPIC=projects/oryxa/topics/gmail-watch
# GOOGLE_GMAIL_PUSH_SERVICE_ACCOUNT=gmail-push@oryxa.iam.gserviceaccount.com

# Local development only. Keep Lambda and KMS on AWS unless the local stack
# explicitly enables those services.
# AWS_ENDPOINT_URL_DYNAMODB=http://192.168.1.4:4566
# AWS_ENDPOINT_URL_SQS=http://192.168.1.4:4566
# EVENTBRIDGE_ENDPOINT=http://192.168.1.4:4566
