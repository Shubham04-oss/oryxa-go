AWS_REGION=ap-south-1
INTEGRATIONS_ADDRESS=:8087
DATABASE_URL=postgres://oryxa:oryxa-dev-password@localhost:5435/oryxa?sslmode=disable
AUTH_URL=http://localhost:8080
CONNECTIONS_URL=http://localhost:8086
# Where providers deliver. It must be a public HTTPS URL that reaches this
# service, since every webhook URL is built on it:
# cloudflared tunnel --url http://localhost:8087
INTEGRATIONS_PUBLIC_BASE_URL=https://integrations.example.test
# Origins that may send cookie-authenticated requests.
INTEGRATIONS_ALLOWED_ORIGINS=http://localhost:3000
# Envelope-encrypts webhook signing secrets. The local stack runs no KMS: use
# a key in AWS, or add kms to LocalStack's SERVICES and set
# AWS_ENDPOINT_URL_KMS.
INTEGRATIONS_KMS_KEY_ID=alias/oryxa-integrations
# The KMS asymmetric key (ECC_NIST_P256) integrations signs its service tokens
# with. Connections must list it in CONNECTIONS_SERVICE_CALLERS with the
# purposes trigger and cleanup, or it refuses every call.
INTEGRATIONS_SERVICE_KEY_ID=alias/oryxa-integrations-identity
EVENT_BUS_NAME=default
DEPLOYMENT_ENVIRONMENT=development
LOG_LEVEL=info
# Connections, auth and teams events. Create the queue with
# go run ./integrations/infra/events/cmd/provision
# INTEGRATIONS_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/integrations-events

# Local development only.
# EVENTBRIDGE_ENDPOINT=http://localhost:4566
# AWS_ENDPOINT_URL_SQS=http://localhost:4566
# AWS_ENDPOINT_URL_KMS=http://localhost:4566
