{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The development Worker. `vite dev` runs it, with the chats', the
  // teamspace rooms', the side conversations' and the direct messages'
  // Durable Objects, in workerd;
  // `.dev.vars` (see `.dev.vars.example`) can point ORYXA_API_ORIGIN at
  // another Go API, and holds REALTIME_PURGE_SECRET, the secret Go signs a
  // purge with (a Worker secret once deployed: `wrangler secret put`).
  //
  // There is deliberately no production environment yet: deploying web-next
  // is deferred until it replaces ../web. When it does, add an `env.production`
  // block as ../web/wrangler.jsonc has one (its own name, `workers_dev` and
  // `preview_urls` off, ORYXA_API_ORIGIN, and the Durable Object bindings and
  // migrations repeated, since wrangler does not inherit them into an env).
  "name": "oryxa-web-next",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "vars": {
    // Where the Worker and its Durable Objects reach the Go API. The
    // browser still calls /v1 on the app's own origin.
    "ORYXA_API_ORIGIN": "http://localhost:8080"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ThreadChatAgent", "class_name": "ThreadChatAgent" },
      { "name": "SpecialistChatAgent", "class_name": "SpecialistChatAgent" },
      { "name": "TeamspaceRoomAgent", "class_name": "TeamspaceRoomAgent" },
      { "name": "DirectMessageAgent", "class_name": "DirectMessageAgent" },
      {
        "name": "SideConversationAgent",
        "class_name": "SideConversationAgent"
      },
      { "name": "InboxAgent", "class_name": "InboxAgent" },
      {
        "name": "RealtimeRegistryAgent",
        "class_name": "RealtimeRegistryAgent"
      }
    ]
  },
  // Append-only: a deployed tag is never edited or reordered. Each new
  // Durable Object class gets a tag of its own after the last one.
  "migrations": [
    { "tag": "thread-chat-v1", "new_sqlite_classes": ["ThreadChatAgent"] },
    {
      "tag": "specialist-chat-v1",
      "new_sqlite_classes": ["SpecialistChatAgent"]
    },
    {
      "tag": "teamspace-room-v1",
      "new_sqlite_classes": ["TeamspaceRoomAgent"]
    },
    {
      "tag": "direct-message-v1",
      "new_sqlite_classes": ["DirectMessageAgent"]
    },
    { "tag": "inbox-v1", "new_sqlite_classes": ["InboxAgent"] },
    {
      "tag": "realtime-registry-v1",
      "new_sqlite_classes": ["RealtimeRegistryAgent"]
    },
    {
      "tag": "side-conversation-v1",
      "new_sqlite_classes": ["SideConversationAgent"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
