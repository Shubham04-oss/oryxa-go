AWS_REGION=ap-south-1
CONNECTIONS_ADDRESS=:8086
DATABASE_URL=postgres://oryxa:oryxa-dev-password@localhost:5435/oryxa?sslmode=disable
AUTH_URL=http://localhost:8080
TEAMS_URL=http://localhost:8083
# Where providers send the browser back to. Register
# {CONNECTIONS_PUBLIC_BASE_URL}/v1/oauth/callback/{provider} as each OAuth
# app's redirect URL and each GitHub App's callback URL.
CONNECTIONS_PUBLIC_BASE_URL=http://localhost:8086
# Origins that may send cookie-authenticated requests, and that connect flows
# may return to.
CONNECTIONS_ALLOWED_ORIGINS=http://localhost:3000
# Envelope-encrypts client secrets, sessions and grants. The local stack runs
# no KMS: use a key in AWS, or add kms to LocalStack's SERVICES and set
# AWS_ENDPOINT_URL_KMS.
CONNECTIONS_KMS_KEY_ID=alias/oryxa-connections
EVENT_BUS_NAME=default
DEPLOYMENT_ENVIRONMENT=development
LOG_LEVEL=info
# Services that may call the internal API, with the KMS keys they sign service
# tokens with and the purposes they may use. Without it, the internal API
# refuses every call.
# CONNECTIONS_SERVICE_CALLERS=[{"service":"integrations","key_id":"alias/oryxa-integrations-identity","purposes":["action","trigger","cleanup"]}]
# Auth and teams events. Create the queue with
# go run ./connections/infra/events/cmd/provision
# CONNECTIONS_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/connections-events

# Local development only.
# EVENTBRIDGE_ENDPOINT=http://localhost:4566
# AWS_ENDPOINT_URL_SQS=http://localhost:4566
# AWS_ENDPOINT_URL_KMS=http://localhost:4566
