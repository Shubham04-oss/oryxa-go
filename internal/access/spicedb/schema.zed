// Oryxa's permissions as relationships (docs/design/permissions, step 4).
//
// It reproduces today's rules and nothing more: the code in internal/access
// still decides, and this schema only answers in shadow until a service
// flips. Tier rules from the design stay out until their step ships.
//
// Services never check against this directly. internal/access turns an actor
// into checks: an agent asks the *_member_reach permissions for its member,
// never the ones with admin arrows, and a specialist must also be granted.
//
// schema.yaml beside this file pins the answers; `zed validate` runs it in CI.

use expiration

definition member {
    // set only for people the org chart names, so a person the chart leaves
    // out is above nobody and below nobody, as runtime.Above does today
    relation chart: org
    // an orgChart edge whose relation is in orgChart.authority
    relation manager: member
    // set only on executives
    relation exec_of: org
    // consent shortcuts (§4); written from step 6
    relation standing_summary: member
    relation lease: member with in_thread and expiration

    // Above: an executive outranks everyone named in the chart but other
    // executives, and nobody outranks an executive.
    permission outranked_by = (manager + manager->outranked_by + chart->executives) - exec_of->participate
    permission summary_without_asking = outranked_by + standing_summary + lease
    permission access_without_asking = lease
}

definition org {
    relation owner: member
    relation admin: member
    relation member: member
    relation executive: member
    permission administer = owner + admin
    permission participate = administer + member
    permission executives = executive
}

definition team {
    relation org: org
    relation parent: team
    relation lead: member
    relation member: member
    // an org admin (own session) or the team's own lead
    permission manage = lead + org->administer
    permission manage_member_reach = lead
    permission see_member_reach = member + lead
    permission see = see_member_reach + org->administer
}

definition agent {
    relation acts_for: member
    relation org: org
}

definition corpus {
    relation org: org
    relation owner: member        // member scope
    relation team: team           // team scope
    relation everyone: org        // org scope
    relation granted: agent
    relation granted_write: agent
    relation created_by: member

    permission read_member_reach = owner + team->see_member_reach + everyone->participate
    permission read = read_member_reach + org->administer
    permission write_member_reach = owner + team->see_member_reach
    permission write = write_member_reach + org->administer
    // a creator deletes only a team corpus, and only while on the team: rag
    // reads the corpus first and refuses an org corpus to all but admins
    permission delete_member_reach = owner + team->manage_member_reach + (created_by & team->see_member_reach)
    permission delete = delete_member_reach + org->administer
}

definition file {
    relation org: org
    relation owner: member
    relation team: team
    relation everyone: org        // access "members"
    relation admins_only: org     // access "admins"
    relation created_by: member
    relation granted: agent

    permission read_member_reach = owner + team->see_member_reach + everyone->participate
    permission read = read_member_reach + org->administer + admins_only->administer
    // as for a corpus: files' canSee comes first, so a creator who can't see
    // the file (someone else's, an org file, a team they left) can't delete it
    permission delete_member_reach = owner + team->manage_member_reach + (created_by & team->see_member_reach)
    permission delete = delete_member_reach + org->administer
}

definition connection {
    relation org: org
    relation owner: member
    relation granted: agent
    relation granted_write: agent
    // seeing it and removing it: its member, or an org admin's own session
    permission read_member_reach = owner
    permission read = read_member_reach + org->administer
    permission delete_member_reach = owner
    permission delete = delete_member_reach + org->administer
    // acting through its credential: its member only, never an admin
    permission use = owner
}

definition source {
    relation org: org
    relation connection: connection
    relation corpus: corpus
    relation created_by: member
    relation granted: agent
    permission manage_member_reach = created_by
    permission manage = manage_member_reach + org->administer
}

definition system {
    relation org: org
    relation owner: member
}

definition request {
    relation org: org
    relation requester: member | agent
    relation target: member
    relation target_agent: agent
    permission read = requester + target + target_agent
    permission decide = target + target_agent
}

caveat in_thread(channel string, thread string, ask_channel string, ask_thread string) {
    channel == ask_channel && thread == ask_thread
}
