            "readOnly": true,
            "type": "string"
          },
          "group_id": {
            "description": "The id of group assigned to at the time of rating",
            "format": "int64",
            "readOnly": true,
            "type": "integer"
          },
          "id": {
            "description": "Automatically assigned upon creation",
            "format": "int64",
            "readOnly": true,
            "type": "integer"
