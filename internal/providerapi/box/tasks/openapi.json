                "nullable": false,
                "type": "string"
              },
              "name": {
                "description": "The display name of this user.",
                "example": "Aaron Levie",
                "maxLength": 50,
                "nullable": false,
                "type": "string"
              }
            }
          }
        ],
        "description": "A mini representation of a user, as can be returned when nested within other\nresources.",
        "title": "User (Mini)",
        "type": "object",
        "x-box-resource-id": "user--mini",
        "x-box-tag": "users",
        "x-box-variant": "mini"
      }
    },
