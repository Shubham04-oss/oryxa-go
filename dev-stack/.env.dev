# The AWS-free dev stack's settings, sourced by up.sh after .env.example.
# No secrets: put your own (TYPESAFE_API_KEY, ...) and any override in
# dev-stack/.env.local, which git ignores. A variable written ${X:-default}
# also takes its value from your shell.

# Ports, so a second stack can run beside the first (README.md).
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-oryxa-go}
POSTGRES_PORT=${POSTGRES_PORT:-5435}
EVENTBRIDGE_PORT=${EVENTBRIDGE_PORT:-4566}
SES_PORT=${SES_PORT:-4567}
MAILPIT_SMTP_PORT=${MAILPIT_SMTP_PORT:-1025}
MAILPIT_UI_PORT=${MAILPIT_UI_PORT:-8025}
API_PORT=${API_PORT:-8080}
AUTHSTUB_PORT=${AUTHSTUB_PORT:-18080}
WEB_PORT=${WEB_PORT:-3001}

ORYXA_ADDRESS=:${API_PORT}
# auth is Cognito and realtime needs the web app's Worker; the stub stands in
# for auth, and realtime stays off. apps needs a Composio key: to run it, set
# COMPOSIO_API_KEY and this list with apps added in .env.local.
ORYXA_SERVICES=${ORYXA_SERVICES:-teams,billing,files,knowledge,rag,batching,email,agents,workspace}
DATABASE_URL=postgres://oryxa:oryxa-dev-password@localhost:${POSTGRES_PORT}/oryxa?sslmode=disable
AUTH_URL=http://127.0.0.1:${AUTHSTUB_PORT}
AUTHSTUB_ADDRESS=127.0.0.1:${AUTHSTUB_PORT}
AUTHSTUB_UPSTREAM=http://127.0.0.1:${API_PORT}

# Everything AWS goes to LocalStack (KMS included), SES to Moto. Nothing
# here can reach real AWS: the credentials are LocalStack's test pair.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=
AWS_ENDPOINT_URL=http://localhost:${EVENTBRIDGE_PORT}
AWS_ENDPOINT_URL_EVENTBRIDGE=${AWS_ENDPOINT_URL}
AWS_ENDPOINT_URL_SQS=${AWS_ENDPOINT_URL}
AWS_ENDPOINT_URL_S3=${AWS_ENDPOINT_URL}
AWS_ENDPOINT_URL_DYNAMODB=${AWS_ENDPOINT_URL}
AWS_ENDPOINT_URL_KMS=${AWS_ENDPOINT_URL}
AWS_ENDPOINT_URL_SESV2=http://localhost:${SES_PORT}
EVENTBRIDGE_ENDPOINT=${AWS_ENDPOINT_URL}
SQS_ENDPOINT=${AWS_ENDPOINT_URL}
EMAIL_SMTP_ADDR=localhost:${MAILPIT_SMTP_PORT}

Q=http://sqs.${AWS_REGION}.localhost.localstack.cloud:${EVENTBRIDGE_PORT}/000000000000
AGENTS_EVENTS_QUEUE_URL=$Q/agents-events
APPS_EVENTS_QUEUE_URL=$Q/apps-events
AUTH_EVENTS_QUEUE_URL=$Q/auth-events
BATCHING_EVENTS_QUEUE_URL=$Q/batching-events
BILLING_EVENTS_QUEUE_URL=$Q/billing-events
EMAIL_QUEUE_URL=$Q/email-events
FILES_EVENTS_QUEUE_URL=$Q/files-events
KNOWLEDGE_EVENTS_QUEUE_URL=$Q/knowledge-events
RAG_EVENTS_QUEUE_URL=$Q/rag-events
TEAMS_EVENTS_QUEUE_URL=$Q/teams-events
WORKSPACE_EVENTS_QUEUE_URL=$Q/workspace-events

# KMS keys, created in LocalStack by up.sh, named as production names them
# (deploy/production/keys.tf).
AGENTS_PRIMARY_SERVICE_KEY_ID=alias/oryxa-dev-agents-primary
KNOWLEDGE_SERVICE_KEY_ID=alias/oryxa-dev-knowledge
RAG_SERVICE_KEY_ID=alias/oryxa-dev-rag
KNOWLEDGE_SERVICE_CALLERS='[{"service":"rag","key_id":"alias/oryxa-dev-rag","purposes":["documents"]}]'
AGENTS_EVENT_SIGNING_KEY_ID=${AGENTS_PRIMARY_SERVICE_KEY_ID}
KNOWLEDGE_EVENT_SIGNING_KEY_ID=${KNOWLEDGE_SERVICE_KEY_ID}
RAG_EVENT_SIGNING_KEY_ID=${RAG_SERVICE_KEY_ID}
APPS_EVENT_SIGNING_KEY_ID=alias/oryxa-dev-apps-events
BATCHING_EVENT_SIGNING_KEY_ID=alias/oryxa-dev-batching-events
BILLING_EVENT_SIGNING_KEY_ID=alias/oryxa-dev-billing-events
FILES_EVENT_SIGNING_KEY_ID=alias/oryxa-dev-files-events
TEAMS_EVENT_SIGNING_KEY_ID=alias/oryxa-dev-teams-events
AGENTS_PRIMARY_SECRETS_KMS_KEY_ID=alias/oryxa-dev-agents-secrets
INTEGRATIONS_KMS_KEY_ID=alias/oryxa-dev-integrations
# Asymmetric signing keys, then symmetric encryption keys, as up.sh makes them.
DEV_SIGNING_KEYS="agents-primary knowledge rag apps-events batching-events billing-events files-events teams-events"
DEV_ENCRYPTION_KEYS="agents-secrets integrations"

# Gemini and rag's embeddings on Vertex, with gcloud ADC
# (`gcloud auth application-default login`): Bedrock is not here.
GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT:-internalbeta}
GOOGLE_CLOUD_LOCATION=global
RAG_DEFAULT_EMBEDDING_PROVIDER=vertex
RAG_DEFAULT_EMBEDDING_MODEL=text-embedding-005
RAG_DEFAULT_BACKEND=pgvector
RAG_VECTOR_BUCKET_NAME=

ORIGINS=http://localhost:3000,http://localhost:${WEB_PORT},http://127.0.0.1:${WEB_PORT}
AGENTS_ALLOWED_ORIGINS=$ORIGINS
APPS_ALLOWED_ORIGINS=$ORIGINS
BILLING_ALLOWED_ORIGINS=$ORIGINS
FILES_ALLOWED_ORIGINS=$ORIGINS
KNOWLEDGE_ALLOWED_ORIGINS=$ORIGINS
RAG_ALLOWED_ORIGINS=$ORIGINS
TEAMS_ALLOWED_ORIGINS=$ORIGINS
APPS_PUBLIC_BASE_URL=http://localhost:${API_PORT}
