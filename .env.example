# One environment for the oryxa binary and every service's provisioner. Copy
# it to the ignored .env and run from the repository root:
#
#   (set -a && . ./.env && go run ./cmd/oryxa)
#
# Each section below belongs to one service. A process needs only the sections
# of the services ORYXA_SERVICES names; the rest are ignored.

# ---------------------------------------------------------------------------
# The process
# ---------------------------------------------------------------------------
ORYXA_ADDRESS=:8080
# Comma-separated services to run; all of them when unset.
# ORYXA_SERVICES=auth,teams,files
# Install every selected service's schema at start, before serving.
# ORYXA_AUTO_MIGRATE=true
# The pool every service shares, unless DATABASE_URL sets pool_max_conns.
# ORYXA_DATABASE_MAX_CONNS=32
# How long requests may take to drain, then workers to stop, on the way down.
# ORYXA_SHUTDOWN_TIMEOUT=30s
# Refuse to start while an events queue is unset: on in production, off
# elsewhere; this sets it either way.
# ORYXA_REQUIRE_EVENT_QUEUES=false
DATABASE_URL=postgres://oryxa:oryxa-dev-password@localhost:5435/oryxa?sslmode=disable
# Enable after the database image or control plane has installed all four.
# POSTGRES_REQUIRED_EXTENSIONS=ltree,pg_trgm,vector,age
AWS_REGION=ap-south-1
EVENT_BUS_NAME=default
# Where this runs, for logs and traces. production also makes every selected
# service's events queue (the *_EVENTS_QUEUE_URL settings, and EMAIL_QUEUE_URL)
# required at start: without one a service only warns, and never hears what
# others deleted.
DEPLOYMENT_ENVIRONMENT=development
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_INSECURE=true

# Services reach one another over HTTP. Each of these defaults to this process
# when it runs the service named; set one only to reach a service that runs
# somewhere else.
# AUTH_URL=
# TEAMS_URL=
# FILES_URL=
# APPS_URL=

# ---------------------------------------------------------------------------
# Local emulators (docker-compose.yml)
# ---------------------------------------------------------------------------
# One process talks to the emulators and to real AWS (KMS, Cognito, Bedrock)
# at once, so name each emulated service's endpoint and never set the global
# AWS_ENDPOINT_URL: it would send KMS and Cognito to LocalStack as well.
# Delete this block to use AWS for everything.
AWS_ENDPOINT_URL_EVENTBRIDGE=http://localhost:4566
AWS_ENDPOINT_URL_SQS=http://localhost:4566
AWS_ENDPOINT_URL_S3=http://localhost:4566
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:4566
AWS_ENDPOINT_URL_SESV2=http://localhost:4567
# Credentials come from your AWS profile (`aws login`); the emulators accept
# any. Running only teams, files, billing and email needs no AWS account:
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# Auth signs its EventBridge and SQS calls with static test credentials when
# these point at an emulator, so real credentials never reach it. Knowledge
# reads EVENTBRIDGE_ENDPOINT too.
EVENTBRIDGE_ENDPOINT=http://localhost:4566
SQS_ENDPOINT=http://localhost:4566

# ---------------------------------------------------------------------------
# auth
# ---------------------------------------------------------------------------
# The Cognito provisioner: go run ./auth/infra/cognito/cmd/provision
COGNITO_POOL_NAME=oryxa-users
COGNITO_APP_CLIENT_NAME=oryxa-web
COGNITO_DOMAIN_PREFIX=oryxa-change-me
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
COGNITO_CALLBACK_URLS=http://localhost:8080/v1/auth/callback
COGNITO_LOGOUT_URLS=http://localhost:3000
# Optional: provisions the agent app client and its resource server too.
# COGNITO_AGENT_CALLBACK_URL=http://localhost:8080/v1/agent-grant/callback

# What the provisioner printed.
COGNITO_ISSUER=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_CALLBACK_URL=http://localhost:8080/v1/auth/callback
AUTH_RETURN_URLS=http://localhost:3000
INVITATION_ACCEPT_URL=http://localhost:3000/invitations/accept
EMAIL_VERIFICATION_URL=http://localhost:3000/auth/verify-email
PASSWORD_RESET_URL=http://localhost:3000/auth/reset-password
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
# Agent grants: all optional; without every one of the first four, agent
# grants are disabled and every /v1/agent-grant* route answers 404.
# COGNITO_AGENT_CLIENT_ID=
# COGNITO_AGENT_CLIENT_SECRET=
# AUTH_KMS_KEY_ID=
# AUTH_SERVICE_CALLERS=[{"service":"agents","key_id":"alias/oryxa-agents-primary","purposes":["agent"]}]
# Billing's entitlement events: go run ./auth/infra/events/cmd/provision
AUTH_EVENTS_QUEUE_NAME=auth-events
AUTH_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/auth-events

# ---------------------------------------------------------------------------
# teams
# ---------------------------------------------------------------------------
TEAMS_ALLOWED_ORIGINS=http://localhost:3000
# Organization and member events: go run ./teams/infra/events/cmd/provision
TEAMS_EVENTS_QUEUE_NAME=teams-events
TEAMS_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/teams-events

# ---------------------------------------------------------------------------
# billing
# ---------------------------------------------------------------------------
# The web app's billing page, where Dodo sends a member back to. It is not
# billing's own address.
BILLING_URL=http://localhost:3000/settings/billing
BILLING_ALLOWED_ORIGINS=http://localhost:3000
# Relative to the directory the process starts in.
BILLING_PLANS_FILE=billing/plans.example.json
BILLING_RENEWAL_REMINDER_DAYS=7
# Organization events: go run ./billing/infra/events/cmd/provision
BILLING_EVENTS_QUEUE_NAME=billing-events
BILLING_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/billing-events
# Dodo Payments test mode. Leave the API key empty to run without checkout,
# the customer portal and webhooks.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=

# ---------------------------------------------------------------------------
# files
# ---------------------------------------------------------------------------
FILES_ALLOWED_ORIGINS=http://localhost:3000
# The bucket and its events queue: go run ./files/infra/storage/cmd/provision
FILES_BUCKET_NAME=oryxa-files
FILES_EVENTS_QUEUE_NAME=files-events
FILES_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/files-events

# ---------------------------------------------------------------------------
# apps (third-party apps through Composio)
# ---------------------------------------------------------------------------
# The Composio project's API key. It reaches every user in the project, so it
# lives only in this process; nothing forwards it and no other service holds
# it. Get one at https://platform.composio.dev.
COMPOSIO_API_KEY=
# Composio's API, when it has to be overridden.
# COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
# Where a member's browser and Composio reach this process. The connect
# callback and the webhook URL are built on it, so it must be what the outside
# world sees: a cloudflared tunnel while developing, the real host in
# production.
APPS_PUBLIC_BASE_URL=http://localhost:8080
# Origins that may send cookie-authenticated requests, and where a member's
# browser may be sent back to after connecting an app.
APPS_ALLOWED_ORIGINS=http://localhost:3000
# Composio signs every delivery with this. Without it every delivery is
# refused, so no trigger fires. The subscription prints it once, at creation:
#   APPS_WEBHOOK_URL=https://<tunnel>/v1/apps/webhooks/composio \
#     go run ./apps/infra/composio/cmd/provision
# COMPOSIO_WEBHOOK_SECRET=
# Auth events: without a queue, apps will not disconnect a member's apps when
# they leave an organization.
# go run ./apps/infra/events/cmd/provision
APPS_EVENTS_QUEUE_NAME=apps-events
# APPS_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/apps-events

# ---------------------------------------------------------------------------
# knowledge
# ---------------------------------------------------------------------------
# Origins that may send cookie-authenticated requests.
KNOWLEDGE_ALLOWED_ORIGINS=http://localhost:3000
# Auth events: without a queue, knowledge will not retire a source when its
# member or organization goes away.
# go run ./knowledge/infra/events/cmd/provision
KNOWLEDGE_EVENTS_QUEUE_NAME=knowledge-events
# KNOWLEDGE_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/knowledge-events

# ---------------------------------------------------------------------------
# rag
# ---------------------------------------------------------------------------
RAG_ALLOWED_ORIGINS=http://localhost:3000
# Lifecycle events, and the optional S3 Vectors bucket:
# go run ./rag/infra/vectors/cmd/provision
RAG_EVENTS_QUEUE_NAME=rag-events
RAG_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/rag-events
# What a corpus gets when its creator does not choose. These are validated at
# startup, because a corpus cannot be changed once it exists.
RAG_DEFAULT_EMBEDDING_PROVIDER=bedrock
RAG_DEFAULT_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
RAG_DEFAULT_METRIC=cosine
RAG_DEFAULT_BACKEND=pgvector
# The S3 Vectors bucket, for corpora on that backend. Without it they are
# refused by name and pgvector corpora still work.
# RAG_VECTOR_BUCKET_NAME=oryxa-vectors
# Answering. There is no default model: the id that works depends on the
# region and on whether a cross-region inference profile is in use, so a guess
# would fail at the first question rather than at startup. Leave it unset and
# rag retrieves but does not answer.
# RAG_ANSWER_PROVIDER=bedrock
# RAG_ANSWER_MODEL=
# RAG_ANSWER_INSTRUCTIONS=
# Reranking, by ARN because the Rerank API takes one and it is region-qualified.
# RAG_RERANK_MODEL_ARN=
# Screen answers through Amazon Bedrock Guardrails. The version must be a
# numbered snapshot, never DRAFT.
# RAG_GUARDRAIL_ID=
# RAG_GUARDRAIL_VERSION=

# ---------------------------------------------------------------------------
# email
# ---------------------------------------------------------------------------
# SES, DynamoDB tables and the queue: go run ./email/infra/delivery/cmd/provision
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Oryxa
SES_CONFIGURATION_SET=oryxa-email
EMAIL_DELIVERIES_TABLE=email-deliveries
EMAIL_SUPPRESSIONS_TABLE=email-suppressions
EMAIL_QUEUE_NAME=email-events
# Required: polling this queue is all email does.
EMAIL_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/email-events
# Moto can't publish SES events; simulate them instead (see email/README.md).
SES_EVENT_PUBLISHING=false
# Local catcher. Open http://localhost:8025. Leave unset to send through SES.
EMAIL_SMTP_ADDR=localhost:1025

# ---------------------------------------------------------------------------
# agents
# ---------------------------------------------------------------------------
# The main model carries the member's conversation and grounded research; the
# lite model carries planning and single-turn bulk work. The agents service
# validates these; cmd/devui and cmd/agentbench run with them.
AGENTS_PRIMARY_MODEL=gemini-3.8-flash
AGENTS_PRIMARY_MODEL_LITE=gemini-3.8-flash-lite
# ADK sessions and state, in the agents_primary schema of DATABASE_URL. The
# binary migrates them under ORYXA_AUTO_MIGRATE; this setting is cmd/devui's.
AGENTS_PRIMARY_AUTO_MIGRATE=true
# The run API: the web app's origin may start runs with the session cookie, a
# run lasts at most this long, and ADK's tables get a pool of this size of
# their own. Without GOOGLE_CLOUD_PROJECT every thread route answers 503.
AGENTS_ALLOWED_ORIGINS=http://localhost:3000
AGENTS_PRIMARY_RUN_TIMEOUT_SECONDS=600
AGENTS_PRIMARY_DATABASE_MAX_CONNS=8
# A Bedrock guardrail screens the member's conversation when both are set; its
# answers then arrive whole rather than streamed. Never pin DRAFT.
# AGENTS_PRIMARY_GUARDRAIL_ID=
# AGENTS_PRIMARY_GUARDRAIL_VERSION=
# AGENTS_PRIMARY_GUARDRAIL_FAIL_CLOSED=false
# App trigger events wake Krude for their member from this queue, created by
# go run ./agents/primary/infra/events/cmd/provision. A member's waiting
# events wake it once this many have come, or the oldest has waited this long.
# AGENTS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/agents-events
AGENTS_WAKEUP_BATCH_SIZE=5
AGENTS_WAKEUP_MAX_WAIT_SECONDS=120
# Where ADK artifacts are kept — screenshots, what save_artifact keeps. Create
# it first: go run ./agents/primary/infra/artifacts/cmd/provision
# Without it artifacts are held in memory and go with the process.
AGENTS_PRIMARY_ARTIFACT_BUCKET=oryxa-agent-artifacts
# Vertex explicit prompt caching keeps a large stable prefix (system instruction
# and tools) in a cache for this long. Vertex's floor for the flash models is
# 4096 tokens; below it the request is left to Vertex's implicit caching.
AGENTS_PRIMARY_PROMPT_CACHE=true
AGENTS_PRIMARY_CACHE_TTL_SECONDS=3600
AGENTS_PRIMARY_CACHE_MIN_TOKENS=4096
# Krude's code, shell and temporary file tools run in Bedrock AgentCore rather
# than on this host. Local credentials come from `aws login`; an AWS deployment
# uses its workload role.
AGENTS_PRIMARY_SANDBOX_CODE_INTERPRETER_ID=aws.codeinterpreter.v1
AGENTS_PRIMARY_SANDBOX_SESSION_TIMEOUT_SECONDS=900
# Interactive website work runs in a separate conversation-scoped AgentCore
# Browser session. Use a custom browser ID when network, recording, profile or
# IAM controls beyond the restrictive AWS-managed browser are required.
AGENTS_PRIMARY_BROWSER_ID=aws.browser.v1
AGENTS_PRIMARY_BROWSER_SESSION_TIMEOUT_SECONDS=900
# The apps toolbox reaches the apps service's MCP endpoint as the session's
# member. cmd/devui needs AUTH_URL and this key to mint a member token; in the
# binary, APPS_URL defaults to this process when it runs apps.
# AGENTS_PRIMARY_SERVICE_KEY_ID=alias/oryxa-agents-primary
# The knowledge toolbox searches rag's corpora as the member. In the binary,
# RAG_URL defaults to this process when it runs rag; cmd/devui needs it named.
# RAG_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Google Cloud (rag's Vertex corpora and answers, the agents' Gemini)
# ---------------------------------------------------------------------------
# Application Default Credentials: run `gcloud auth application-default login`
# once, then name the project.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
