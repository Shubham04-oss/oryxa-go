# One environment for the oryxa binary and every service's provisioner. Copy
# it to the ignored .env and run from the repository root:
#
#   (set -a && . ./.env && go run ./cmd/oryxa)
#
# Each section below belongs to one service. A process needs only the sections
# of the services ORYXA_SERVICES names; the rest are ignored.

# ---------------------------------------------------------------------------
# The process
# ---------------------------------------------------------------------------
ORYXA_ADDRESS=:8080
# Comma-separated services to run; all of them when unset.
# ORYXA_SERVICES=auth,teams,files
# Install every selected service's schema at start, before serving.
# ORYXA_AUTO_MIGRATE=true
# The pool every service shares, unless DATABASE_URL sets pool_max_conns.
# ORYXA_DATABASE_MAX_CONNS=32
# How long requests may take to drain, then workers to stop, on the way down.
# ORYXA_SHUTDOWN_TIMEOUT=30s
# Refuse to start while an events queue is unset: on in production, off
# elsewhere; this sets it either way.
# ORYXA_REQUIRE_EVENT_QUEUES=false
# Every event is signed by the service that publishes it and checked before a
# consumer acts on it. report (the default) logs a signature that does not
# check out and handles the event anyway; enforce refuses it. Enforce only
# once every service has a KMS key below: a service without one signs with a
# key minted at boot, and whatever it published that is still queued when the
# process restarts can never be verified by the next one.
# ORYXA_EVENT_SIGNATURES=report
# The KMS key (ECC_NIST_P256, SIGN_VERIFY) each service signs its events with,
# <SERVICE>_EVENT_SIGNING_KEY_ID; the process needs kms:Sign and
# kms:GetPublicKey on every one. Separate from the *_SERVICE_KEY_ID keys a
# service proves itself to another with.
# AUTH_EVENT_SIGNING_KEY_ID=alias/oryxa-auth-events
DATABASE_URL=postgres://oryxa:oryxa-dev-password@localhost:5435/oryxa?sslmode=disable
# Enable after the database image or control plane has installed all four.
# POSTGRES_REQUIRED_EXTENSIONS=ltree,pg_trgm,vector,age
AWS_REGION=ap-south-1
EVENT_BUS_NAME=default
# Where this runs, for logs and traces. production also makes every selected
# service's events queue (the *_EVENTS_QUEUE_URL settings, and EMAIL_QUEUE_URL)
# required at start: without one a service only warns, and never hears what
# others deleted.
DEPLOYMENT_ENVIRONMENT=development
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_INSECURE=true

# Services reach one another over HTTP. Each of these defaults to this process
# when it runs the service named; set one only to reach a service that runs
# somewhere else.
# AUTH_URL=
# TEAMS_URL=
# WORKSPACE_URL=
# FILES_URL=
# APPS_URL=
# KNOWLEDGE_URL=

# ---------------------------------------------------------------------------
# Local emulators (docker-compose.yml)
# ---------------------------------------------------------------------------
# One process talks to the emulators and to real AWS (KMS, Cognito, Bedrock)
# at once, so name each emulated service's endpoint and never set the global
# AWS_ENDPOINT_URL: it would send KMS and Cognito to LocalStack as well.
# Delete this block to use AWS for everything.
AWS_ENDPOINT_URL_EVENTBRIDGE=http://localhost:4566
AWS_ENDPOINT_URL_SQS=http://localhost:4566
AWS_ENDPOINT_URL_S3=http://localhost:4566
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:4566
AWS_ENDPOINT_URL_SESV2=http://localhost:4567
# Credentials come from your AWS profile (`aws login`); the emulators accept
# any. Running only teams, files, billing and email needs no AWS account:
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# Auth signs its EventBridge and SQS calls with static test credentials when
# these point at an emulator, so real credentials never reach it. Knowledge
# reads EVENTBRIDGE_ENDPOINT too.
EVENTBRIDGE_ENDPOINT=http://localhost:4566
SQS_ENDPOINT=http://localhost:4566

# ---------------------------------------------------------------------------
# auth
# ---------------------------------------------------------------------------
# The Cognito provisioner: go run ./auth/infra/cognito/cmd/provision
COGNITO_POOL_NAME=oryxa-users
COGNITO_APP_CLIENT_NAME=oryxa-web
COGNITO_DOMAIN_PREFIX=oryxa-change-me
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
COGNITO_CALLBACK_URLS=http://localhost:8080/v1/auth/callback
COGNITO_LOGOUT_URLS=http://localhost:3000
# Optional: provisions the agent app client and its resource server too.
# COGNITO_AGENT_CALLBACK_URL=http://localhost:8080/v1/agent-grant/callback
# Optional: provisions the public setup CLI client with a fixed loopback redirect.
# COGNITO_CLI_CALLBACK_URL=http://127.0.0.1:8765/callback

# What the provisioner printed.
COGNITO_ISSUER=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_CALLBACK_URL=http://localhost:8080/v1/auth/callback
# COGNITO_CLI_CLIENT_ID=
# COGNITO_CLI_CALLBACK_URL=http://127.0.0.1:8765/callback
AUTH_RETURN_URLS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001
# web-next. Keep these on localhost, the host of COGNITO_CALLBACK_URL: cookies
# follow the host and ignore the port, so a Google sign-in started on
# 127.0.0.1 loses its state cookie at the callback.
INVITATION_ACCEPT_URL=http://localhost:3001/invitations/accept
EMAIL_VERIFICATION_URL=http://localhost:3001/auth/verify-email
PASSWORD_RESET_URL=http://localhost:3001/auth/reset-password
AUTH_COOKIE_DOMAIN=
# Disable when the Cognito app client does not have a Google identity provider.
AUTH_GOOGLE_ENABLED=true
AUTH_COOKIE_SECURE=false
# Agent grants: all optional; without every one of the first four, agent
# grants are disabled and every /v1/agent-grant* route answers 404.
# COGNITO_AGENT_CLIENT_ID=
# COGNITO_AGENT_CLIENT_SECRET=
# AUTH_KMS_KEY_ID=
# AUTH_SERVICE_CALLERS=[{"service":"agents","key_id":"alias/oryxa-agents-primary","purposes":["agent"]},{"service":"knowledge","key_id":"alias/oryxa-knowledge","purposes":["agent"]}]
# Billing's entitlement events: go run ./auth/infra/events/cmd/provision
AUTH_EVENTS_QUEUE_NAME=auth-events
AUTH_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/auth-events

# ---------------------------------------------------------------------------
# teams
# ---------------------------------------------------------------------------
TEAMS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001
# Organization and member events: go run ./teams/infra/events/cmd/provision
TEAMS_EVENTS_QUEUE_NAME=teams-events
TEAMS_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/teams-events

# ---------------------------------------------------------------------------
# workspace
# ---------------------------------------------------------------------------
# Lifecycle cleanup: go run ./internal/workspace/infra/events/cmd/provision
WORKSPACE_EVENTS_QUEUE_NAME=workspace-events
WORKSPACE_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/workspace-events

# ---------------------------------------------------------------------------
# billing
# ---------------------------------------------------------------------------
# The web app's billing page, where Dodo sends a member back to. It is not
# billing's own address.
BILLING_URL=http://localhost:3000/settings/billing
BILLING_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001
# Relative to the directory the process starts in.
BILLING_PLANS_FILE=billing/plans.example.json
BILLING_RENEWAL_REMINDER_DAYS=7
# Organization events: go run ./billing/infra/events/cmd/provision
BILLING_EVENTS_QUEUE_NAME=billing-events
BILLING_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/billing-events
# Dodo Payments test mode. Leave the API key empty to run without checkout,
# the customer portal and webhooks.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=

# ---------------------------------------------------------------------------
# files
# ---------------------------------------------------------------------------
FILES_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001
# The bucket and its events queue: go run ./files/infra/storage/cmd/provision
FILES_BUCKET_NAME=oryxa-files
FILES_EVENTS_QUEUE_NAME=files-events
FILES_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/files-events

# ---------------------------------------------------------------------------
# apps (third-party apps through Composio)
# ---------------------------------------------------------------------------
# The Composio project's API key. It reaches every user in the project, so it
# lives only in this process; nothing forwards it and no other service holds
# it. Get one at https://platform.composio.dev.
COMPOSIO_API_KEY=
# Composio's API, when it has to be overridden.
# COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
# Where a member's browser and Composio reach this process. The connect
# callback and the webhook URL are built on it, so it must be what the outside
# world sees: a cloudflared tunnel while developing, the real host in
# production.
APPS_PUBLIC_BASE_URL=http://localhost:8080
# Origins that may send cookie-authenticated requests, and where a member's
# browser may be sent back to after connecting an app.
APPS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001
# Composio signs every delivery with this. Without it every delivery is
# refused, so no trigger fires. The subscription prints it once, at creation:
#   APPS_WEBHOOK_URL=https://<tunnel>/v1/apps/webhooks/composio \
#     go run ./apps/infra/composio/cmd/provision
# COMPOSIO_WEBHOOK_SECRET=
# Connecting an app subscribes it to every event it can deliver, so a member
# who connects GitHub starts hearing about GitHub. Set false to have members
# choose their own events instead; they can also say so per connection.
# Every event that fires wakes Krude, which costs a run.
# APPS_AUTO_SUBSCRIBE=true
# Auth events: without a queue, apps will not disconnect a member's apps when
# they leave an organization.
# go run ./apps/infra/events/cmd/provision
APPS_EVENTS_QUEUE_NAME=apps-events
# APPS_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/apps-events
# Oryxa's own sign-in, beside Composio (apps/README.md, "Oryxa's own sign-in").
# Off until a toolkit is named here, as a comma list (github,slack,notion);
# empty, every app connects through Composio and every Oryxa request is
# refused. Each toolkit must ship in this build.
# APPS_ORYXA_TOOLKITS=
# The KMS key every credential and webhook secret is sealed with, bound to
# service oryxa-apps. Required once a toolkit is named; with it alone,
# connections already made through Oryxa are still checked and revoked.
# APPS_SIGNIN_KMS_KEY_ID=alias/oryxa-apps-signin
# The one OAuth callback, registered with every app's OAuth client. The state
# cookie comes back only to the host that set it, so this must be on the host
# the browser sends the connect request to: the web app's own origin, which
# proxies /v1 to apps (app.oryxa.in in production; web-next's dev server
# here). Its path is always /v1/apps/oauth/callback. Required with the key.
# APPS_SIGNIN_REDIRECT_URI=http://localhost:3000/v1/apps/oauth/callback
# Oryxa's own OAuth apps, which members sign in through unless their
# organization brings its own. Saved, sealed, when apps starts.
# (JSON is single-quoted, so sourcing this file keeps its double quotes.)
# APPS_DEFAULT_OAUTH_CLIENTS='{"github":{"client_id":"","client_secret":""}}'
# The deployment's webhook secrets, per toolkit: the current one, and during
# a rotation the previous one too. Webhook URLs are built on
# APPS_PUBLIC_BASE_URL.
# APPS_HOOK_SECRETS='{"slack":["current","previous"]}'
# Values a manifest names as {config:name}, such as the service account
# Gmail's Pub/Sub pushes are signed for.
# APPS_HOOK_VALUES='{"pubsub_push_account":""}'
# The services that may call apps' internal routes (the deployment's own
# webhook endpoints), each signing a service token with purpose hooks.
# Without them there are no internal routes.
# APPS_SERVICE_CALLERS='[{"service":"operator","key_id":"alias/oryxa-operator","purposes":["hooks"]}]'

# ---------------------------------------------------------------------------
# batching (app-trigger coalescing before agent wakeups)
# ---------------------------------------------------------------------------
# App trigger and auth lifecycle events:
# go run ./batching/infra/events/cmd/provision
BATCHING_EVENTS_QUEUE_NAME=batching-events
# BATCHING_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/batching-events
BATCHING_BATCH_SIZE=5
BATCHING_MAX_WAIT=1h
BATCHING_LARGEST_BATCH=20
BATCHING_SWEEP_INTERVAL=1s
BATCHING_CLAIM_LEASE=1m
BATCHING_GROUPS_PER_SWEEP=8
# Jev classification. Without a key, every event uses the deterministic digest
# lane. The stored/batched payload remains complete; Jev receives at most a
# bounded projection for classification.
TYPESAFE_API_KEY=
# HTTPS only, since every request carries the key; plain HTTP just to localhost.
TYPESAFE_BASE_URL=https://api.typesafe.ai
BATCHING_JEV_MODEL=jev-latest
# At most 10s, well inside the batching queue's 60s visibility timeout.
BATCHING_JEV_TIMEOUT=3s
BATCHING_JEV_IMMEDIATE_PROBABILITY=0.85
BATCHING_JEV_MIN_CONFIDENCE=0.60

# ---------------------------------------------------------------------------
# knowledge
# ---------------------------------------------------------------------------
# Origins that may send cookie-authenticated requests.
KNOWLEDGE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001
# Auth events: without a queue, knowledge will not retire a source when its
# member or organization goes away.
# go run ./knowledge/infra/events/cmd/provision
KNOWLEDGE_EVENTS_QUEUE_NAME=knowledge-events
# What a connected app yields is judged worth indexing, or not, before it is
# published: jev (TypeSafe's classifier, with TYPESAFE_API_KEY above, which
# sends each document's first few thousand characters to TypeSafe), gemini
# (KNOWLEDGE_JUDGE_MODEL on Vertex AI), or off. With jev, KNOWLEDGE_JUDGE_MODEL
# decides what Jev is less sure of than KNOWLEDGE_JUDGE_ESCALATE_BELOW, and the
# PDFs it cannot read. Unset with a model: gemini; unset without one: off.
# Gmail's Promotions and Social, and empty documents, are kept out regardless.
# KNOWLEDGE_JUDGE=jev
# KNOWLEDGE_JUDGE_MODEL=gemini-3.5-flash-lite
# KNOWLEDGE_JUDGE_JEV_MODEL=jev-latest
# KNOWLEDGE_JUDGE_ESCALATE_BELOW=0.8
# KNOWLEDGE_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/knowledge-events

# ---------------------------------------------------------------------------
# rag
# ---------------------------------------------------------------------------
RAG_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001
# Lifecycle events, and the optional S3 Vectors bucket:
# go run ./rag/infra/vectors/cmd/provision
RAG_EVENTS_QUEUE_NAME=rag-events
RAG_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/rag-events
# What a corpus gets when its creator does not choose. These are validated at
# startup, because a corpus cannot be changed once it exists.
RAG_DEFAULT_EMBEDDING_PROVIDER=bedrock
RAG_DEFAULT_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
RAG_DEFAULT_METRIC=cosine
# The S3 Vectors bucket. With one named, new corpora go to S3 Vectors unless
# RAG_DEFAULT_BACKEND says otherwise; without one they go to pgvector, which
# is what local development uses (S3 Vectors has no local emulation). A corpus
# keeps the backend it was created on.
# RAG_VECTOR_BUCKET_NAME=oryxa-vectors
# RAG_DEFAULT_BACKEND=pgvector
# A Bedrock knowledge base: fully managed and serverless, and the only backend
# that parses PDF and Office files itself rather than needing extracted text.
# OpenTofu creates the knowledge base and its one data source; rag only needs
# their ids. Both are required together for the backend to be available at
# all; naming RAG_DEFAULT_BACKEND makes it the default for new corpora, which
# is not implied by configuring one the way S3 Vectors is by its bucket. The
# bucket is where rag stages document text too large to send inline before
# handing it to the knowledge base; without it, such a document is refused by
# name rather than failing at ingest.
# RAG_KNOWLEDGE_BASE_ID=
# RAG_KNOWLEDGE_BASE_DATA_SOURCE_ID=
# RAG_KNOWLEDGE_BASE_BUCKET=oryxa-rag-staging
# RAG_DEFAULT_BACKEND=bedrock-kb
# Answering. There is no default model: the id that works depends on the
# region and on whether a cross-region inference profile is in use, so a guess
# would fail at the first question rather than at startup. Leave it unset and
# rag retrieves but does not answer.
# RAG_ANSWER_PROVIDER=bedrock
# RAG_ANSWER_MODEL=
# RAG_ANSWER_INSTRUCTIONS=
# Reranking, with a Bedrock model by ARN (the Rerank API takes one and it is
# region-qualified) or with a Vertex ranking model through Google's Ranking API
# (serverless; needs discoveryengine.googleapis.com on GOOGLE_CLOUD_PROJECT).
# Set one or neither.
# RAG_RERANK_MODEL_ARN=
# RAG_RERANK_VERTEX_MODEL=semantic-ranker-default@latest
# Screen answers through Amazon Bedrock Guardrails. The version must be a
# numbered snapshot, never DRAFT.
# RAG_GUARDRAIL_ID=
# RAG_GUARDRAIL_VERSION=

# ---------------------------------------------------------------------------
# email
# ---------------------------------------------------------------------------
# SES, DynamoDB tables and the queue: go run ./email/infra/delivery/cmd/provision
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Oryxa
SES_CONFIGURATION_SET=oryxa-email
# Send from this region when SES's verified domain and production access live
# somewhere other than the deployment's AWS_REGION. Unset: AWS_REGION.
# SES_REGION=ap-south-1
EMAIL_DELIVERIES_TABLE=email-deliveries
EMAIL_SUPPRESSIONS_TABLE=email-suppressions
EMAIL_QUEUE_NAME=email-events
# Required: polling this queue is all email does.
EMAIL_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/email-events
# Moto can't publish SES events; simulate them instead (see email/README.md).
SES_EVENT_PUBLISHING=false
# Local catcher. Open http://localhost:8025. Leave unset to send through SES.
EMAIL_SMTP_ADDR=localhost:1025

# ---------------------------------------------------------------------------
# agents
# ---------------------------------------------------------------------------
# The main model carries the member's conversation and grounded research; the
# lite model carries planning and single-turn bulk work. The agents service
# validates these; cmd/devui and cmd/agentbench run with them.
AGENTS_PRIMARY_MODEL=gemini-3.5-flash-lite
AGENTS_PRIMARY_MODEL_LITE=gemini-3.5-flash-lite
# How much the model thinks on each call of a run delivering an agent request,
# and of no other run: minimal, low, medium or high, a Gemini 3 thinking level.
# Unset, each model thinks as it does by default. A level either model does not
# take (gemini-3.8-flash takes no minimal) refuses to start.
# AGENTS_PRIMARY_DELIVERY_THINKING=low
# ADK sessions and state, in the agents_primary schema of DATABASE_URL. The
# binary migrates them under ORYXA_AUTO_MIGRATE; this setting is cmd/devui's.
AGENTS_PRIMARY_AUTO_MIGRATE=true
# The run API: the web app's origin may start runs with the session cookie, a
# run lasts at most this long, and ADK's tables get a pool of this size of
# their own. Without GOOGLE_CLOUD_PROJECT every thread route answers 503.
AGENTS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001
AGENTS_PRIMARY_RUN_TIMEOUT_SECONDS=600
AGENTS_PRIMARY_DATABASE_MAX_CONNS=8
# A Bedrock guardrail screens the member's conversation when both are set; its
# answers then arrive whole rather than streamed. Never pin DRAFT.
# AGENTS_PRIMARY_GUARDRAIL_ID=
# AGENTS_PRIMARY_GUARDRAIL_VERSION=
# AGENTS_PRIMARY_GUARDRAIL_FAIL_CLOSED=false
# The answer guard: a Bedrock guardrail reads every answer one member's agent
# gives another before they read it, masking secrets and holding email
# addresses, phone numbers and addresses for the answering member's review.
# Both or neither; unset, answers are delivered unchecked. A stand-in for
# Bedrock can take its calls through AWS_ENDPOINT_URL_BEDROCK_RUNTIME.
# AGENTS_PRIMARY_ANSWER_GUARDRAIL_ID=
# AGENTS_PRIMARY_ANSWER_GUARDRAIL_VERSION=
# AWS_ENDPOINT_URL_BEDROCK_RUNTIME=
# Batching's trigger batches wake Krude for their member from this queue,
# created by go run ./agents/primary/infra/events/cmd/provision. Batching has
# already decided when a member's triggers make a batch, so one wakes Krude as
# it arrives; raise the size only to hold batches back a second time.
# AGENTS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/agents-events
AGENTS_WAKEUP_BATCH_SIZE=1
AGENTS_WAKEUP_MAX_WAIT_SECONDS=120
# Durable team workflows use a Step Functions Standard state machine whose
# callback task is delivered through this queue. EventBridge Scheduler starts
# that same state machine for rate/cron/one-time schedules. Production
# provisioning fills all five values; endpoint overrides are useful only for
# an emulator that implements Step Functions and Scheduler.
# AGENTS_WORKFLOW_QUEUE_URL=
# AGENTS_WORKFLOW_STATE_MACHINE_ARN=
# AGENTS_WORKFLOW_SCHEDULER_ROLE_ARN=
# AGENTS_WORKFLOW_SCHEDULE_DLQ_ARN=
# AGENTS_WORKFLOW_SCHEDULER_GROUP=oryxa-agent-workflows
# AWS_ENDPOINT_URL_SFN=
# AWS_ENDPOINT_URL_SCHEDULER=
# Development only: execute the real workflow service and model calls in this
# process. This is intentionally not restart-durable and supports at/rate, not
# cron; production must leave it false and use the AWS resources above.
# AGENTS_WORKFLOW_LOCAL=false
# Where ADK artifacts are kept — screenshots, what save_artifact keeps. Create
# it first: go run ./agents/primary/infra/artifacts/cmd/provision
# Without it artifacts are held in memory and go with the process.
AGENTS_PRIMARY_ARTIFACT_BUCKET=oryxa-agent-artifacts
# The Vertex AI agent engine whose memory bank holds what Krude remembers
# across a member's threads. Its bank needs similarity search configured.
# Without it Krude remembers nothing between threads: nothing is written and
# nothing is recalled. Memories are scoped to the member's organization, and
# forgotten when they leave it or it is deleted.
# AGENTS_PRIMARY_MEMORY_AGENT_ENGINE=1234567890
# Agent engines are regional, so this names the region the engine is in —
# us-west1, say — and not the global endpoint the models are served from; the
# service refuses to start otherwise. It defaults to GOOGLE_CLOUD_LOCATION.
# AGENTS_PRIMARY_MEMORY_LOCATION=us-west1
# How many memories one search returns; 0 leaves the default of 10, and
# Memory Bank caps it at 100.
AGENTS_PRIMARY_MEMORY_RECALLED=0
# Vertex explicit prompt caching keeps a large stable prefix (system instruction
# and tools) in a cache for this long. Vertex's floor for the flash models is
# 4096 tokens; below it the request is left to Vertex's implicit caching.
AGENTS_PRIMARY_PROMPT_CACHE=true
AGENTS_PRIMARY_CACHE_TTL_SECONDS=3600
AGENTS_PRIMARY_CACHE_MIN_TOKENS=4096
# Krude's code, shell and temporary file tools run in Bedrock AgentCore rather
# than on this host. Local credentials come from `aws login`; an AWS deployment
# uses its workload role.
AGENTS_PRIMARY_SANDBOX_CODE_INTERPRETER_ID=aws.codeinterpreter.v1
AGENTS_PRIMARY_SANDBOX_SESSION_TIMEOUT_SECONDS=900
# Interactive website work runs in a separate conversation-scoped AgentCore
# Browser session. Use a custom browser ID when network, recording, profile or
# IAM controls beyond the restrictive AWS-managed browser are required.
AGENTS_PRIMARY_BROWSER_ID=aws.browser.v1
AGENTS_PRIMARY_BROWSER_SESSION_TIMEOUT_SECONDS=900
# The apps toolbox reaches the apps service's MCP endpoint as the session's
# member. cmd/devui needs AUTH_URL and this key to mint a member token; in the
# binary, APPS_URL defaults to this process when it runs apps.
# AGENTS_PRIMARY_SERVICE_KEY_ID=alias/oryxa-agents-primary
# Knowledge signs its own identity with this when asking auth for a member's
# token: a scheduled pass, or an app connected while the member is away, has
# no member at a browser, so it redeems the standing agent grant they gave.
# Also add knowledge to AUTH_SERVICE_CALLERS with the "agent" purpose. Without
# both, neither the organization's own files (which also need FILES_URL) nor
# what a newly connected app holds are indexed for the member.
# KNOWLEDGE_SERVICE_KEY_ID=alias/oryxa-knowledge
# Rag signs its own identity with this to read back a knowledge document too
# large to have travelled on the bus. Without it, and without knowledge
# admitting rag below, the largest documents an organization has stay
# unindexed.
# RAG_SERVICE_KEY_ID=alias/oryxa-rag
# Which services may read a document's body through knowledge's internal API.
# KNOWLEDGE_SERVICE_CALLERS=[{"service":"rag","key_id":"alias/oryxa-rag","purposes":["documents"]}]
# The knowledge toolbox searches rag's corpora as the member. In the binary,
# RAG_URL defaults to this process when it runs rag; cmd/devui needs it named.
# RAG_URL=http://localhost:8080
# The agent's read-only knowledge_sources tool reports which connected app
# targets were indexed and when their last extraction completed. In the
# binary KNOWLEDGE_URL defaults to this process when it runs knowledge;
# cmd/devui needs it named to expose this tool.
# KNOWLEDGE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# realtime (purges the web app's direct messages and side conversations)
# ---------------------------------------------------------------------------
# The web app keeps those only in its Worker's Durable Objects. When a member
# leaves an organization, or it is deleted, realtime has the Worker purge
# them, signing each call with REALTIME_PURGE_SECRET. It is off until the
# Worker's URL, the secret and the queue are all set, and
# ORYXA_SERVICES=realtime refuses to start without them.
# Auth's membership events: go run ./realtime/infra/events/cmd/provision
REALTIME_EVENTS_QUEUE_NAME=realtime-events
# REALTIME_EVENTS_QUEUE_URL=http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/realtime-events
# The web app's origin; its Worker takes POST /internal/realtime/purge there.
# web-next serves on 3001 while developing.
# REALTIME_WORKER_URL=http://localhost:3001
# At least 32 characters (openssl rand -hex 32). The Worker must hold the same
# value; its characters are the HMAC key as written, never decoded from hex.
# Production's put-secrets.sh stores only the 64 hex characters openssl makes,
# unquoted.
# REALTIME_PURGE_SECRET=

# ---------------------------------------------------------------------------
# Google Cloud (rag's Vertex corpora and answers, the agents' Gemini)
# ---------------------------------------------------------------------------
# Application Default Credentials: run `gcloud auth application-default login`
# once, then name the project.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# On AWS there is no such login and no key worth holding: the process signs in
# with its AWS identity through a workload identity pool provider that admits
# its role, and acts as this service account (internal/gcpauth). Both or
# neither; with neither, Application Default Credentials are used.
# GOOGLE_WORKLOAD_IDENTITY_PROVIDER=//iam.googleapis.com/projects/<project number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
# GOOGLE_SERVICE_ACCOUNT=oryxa@<project>.iam.gserviceaccount.com
