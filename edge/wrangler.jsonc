// oryxa-edge: the live layer (docs/design/live-layer/README.md). platform-1
// owns this file; integration-2 adds its call and voice bindings through a
// PR here (README, "Shared files"). Environments, routes and secrets are F4.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oryxa-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "SANDBOX", "class_name": "SandboxDO" },
      { "name": "BROWSER_SESSION", "class_name": "BrowserDO" },
      { "name": "VOICE", "class_name": "VoiceDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "SandboxDO", "BrowserDO", "VoiceDO"] }],
  "r2_buckets": [{ "binding": "RUNS", "bucket_name": "oryxa-runs" }],
  "browser": { "binding": "BROWSER" },
  // The room sandbox image (A1). Cloudflare builds and pushes it on deploy;
  // A9's CI job builds it on every change to catch a broken Dockerfile.
  "containers": [
    {
      "name": "oryxa-sandbox",
      "class_name": "SandboxDO",
      "images": { "sandbox": { "dockerfile": "./containers/sandbox/Dockerfile" } },
      "scheduling_policy": "durable_object"
    }
  ],
  // Workers AI: the call agent's text to speech (integration-2, B4).
  "ai": { "binding": "AI" },
  "vars": {
    "ENVIRONMENT": "production",
    "EDGE_PUBLIC_URL": "https://edge.oryxa.in",
    "SANDBOX_INSTANCE": "standard-1",
    // Calls (integration-2, B1–B5). The RealtimeKit app's ids and webhook key
    // are B7's to fill; secrets: REALTIMEKIT_API_TOKEN, GEMINI_API_KEY,
    // EDGE_SIGNING_KEY. Until they are set, calls answer 503.
    "REALTIMEKIT_ACCOUNT_ID": "",
    "REALTIMEKIT_APP_ID": "",
    "REALTIMEKIT_WEBHOOK_PUBLIC_KEY": "",
    "VOICE_AGENT_NAME": "Krude",
    "AGENTS_URL": "https://api.oryxa.in",
    // agents' serviceauth KMS public key (base64 DER SPKI). Public, so a var.
    "AGENTS_TOKEN_PUBLIC_KEYS": "[]"
  },
  "env": {
    "staging": {
      "name": "oryxa-edge-staging",
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "RoomDO" },
          { "name": "SANDBOX", "class_name": "SandboxDO" },
          { "name": "BROWSER_SESSION", "class_name": "BrowserDO" },
          { "name": "VOICE", "class_name": "VoiceDO" }
        ]
      },
      "r2_buckets": [{ "binding": "RUNS", "bucket_name": "oryxa-runs-staging" }],
      "browser": { "binding": "BROWSER" },
      "containers": [
        {
          "name": "oryxa-sandbox-staging",
          "class_name": "SandboxDO",
          "images": { "sandbox": { "dockerfile": "./containers/sandbox/Dockerfile" } },
          "scheduling_policy": "durable_object"
        }
      ],
      "ai": { "binding": "AI" },
      "vars": {
        "ENVIRONMENT": "staging",
        "EDGE_PUBLIC_URL": "https://edge-staging.oryxa.in",
        "SANDBOX_INSTANCE": "standard-1",
        "AGENTS_TOKEN_PUBLIC_KEYS": "[]",
        "REALTIMEKIT_ACCOUNT_ID": "",
        "REALTIMEKIT_APP_ID": "",
        "REALTIMEKIT_WEBHOOK_PUBLIC_KEY": "",
        "VOICE_AGENT_NAME": "Krude",
        "AGENTS_URL": "https://api-staging.oryxa.in"
      }
    }
  }
}
