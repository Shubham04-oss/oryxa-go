// oryxa-edge: the live layer (docs/design/live-layer/README.md). platform-1
// owns this file; integration-2 adds its call and voice bindings through a
// PR here (README, "Shared files"). Environments, routes and secrets are F4.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oryxa-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "SANDBOX", "class_name": "SandboxDO" },
      { "name": "BROWSER_SESSION", "class_name": "BrowserDO" },
      { "name": "VOICE", "class_name": "VoiceDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "SandboxDO", "BrowserDO", "VoiceDO"] }],
  "r2_buckets": [{ "binding": "RUNS", "bucket_name": "oryxa-runs" }],
  "browser": { "binding": "BROWSER" },
  // The room sandbox image (A1). Cloudflare builds and pushes it on deploy;
  // A9's CI job builds it on every change to catch a broken Dockerfile.
  "containers": [
    {
      "name": "oryxa-sandbox",
      "class_name": "SandboxDO",
      "images": { "sandbox": { "dockerfile": "./containers/sandbox/Dockerfile" } },
      "scheduling_policy": "durable_object"
    }
  ],
  // Workers AI: the call agent's text to speech (integration-2, B4).
  "ai": { "binding": "AI" },
  "vars": {
    "ENVIRONMENT": "production",
    "EDGE_PUBLIC_URL": "https://edge.oryxa.in",
    "SANDBOX_INSTANCE": "standard-1",
    // Calls (integration-2, B1–B5). The RealtimeKit app's ids and webhook key
    // are B7's to fill; secrets: REALTIMEKIT_API_TOKEN, GEMINI_API_KEY,
    // EDGE_SIGNING_KEY. Until they are set, calls answer 503.
    "REALTIMEKIT_ACCOUNT_ID": "",
    "REALTIMEKIT_APP_ID": "",
    "REALTIMEKIT_WEBHOOK_PUBLIC_KEY": "",
    "VOICE_AGENT_NAME": "Krude",
    "AGENTS_URL": "https://api.oryxa.in",
    // agents' serviceauth KMS public key (base64 DER SPKI). Public, so a var.
    // Production trusts only production agents' key
    // (alias/oryxa-production-agents-primary, us-west-2).
    "AGENTS_TOKEN_PUBLIC_KEYS": "[\"MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEiWs2zaZoVzNeNIyQ33jeyNFqzGFxFX1bR5BJBIq0Qy22yBgQNKJjGD+ejgM290hi/BfIS+uCwMQfpcZ/TbmYHQ==\"]"
  },
  "routes": [{ "pattern": "edge.oryxa.in", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "oryxa-edge-staging",
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "RoomDO" },
          { "name": "SANDBOX", "class_name": "SandboxDO" },
          { "name": "BROWSER_SESSION", "class_name": "BrowserDO" },
          { "name": "VOICE", "class_name": "VoiceDO" }
        ]
      },
      "r2_buckets": [{ "binding": "RUNS", "bucket_name": "oryxa-runs-staging" }],
      "browser": { "binding": "BROWSER" },
      "containers": [
        {
          "name": "oryxa-sandbox-staging",
          "class_name": "SandboxDO",
          "images": { "sandbox": { "dockerfile": "./containers/sandbox/Dockerfile" } },
          "scheduling_policy": "durable_object"
        }
      ],
      "ai": { "binding": "AI" },
      "vars": {
        "ENVIRONMENT": "staging",
        "EDGE_PUBLIC_URL": "https://edge-staging.oryxa.in",
        "SANDBOX_INSTANCE": "standard-1",
        // The test key (edge/DEPLOY.md's check) and the staging agents key
        // (alias/oryxa-staging-agents-primary in ap-south-1, the a1 dev stack). Never in production.
        "AGENTS_TOKEN_PUBLIC_KEYS": "[\"MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEqtvQb0ZpfBSXWZnRipeubHTIJ8ZU2bdTqq9XOoB1SBUzz8fCsBcIzn0ZT11ZthtfGZM9dvubZEJrkGAqoe4Phw==\", \"MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEEIUW7m/GXYVWtDOhJlgPWpJLzcrqvV87OhkL87F0jYv5iRD1NY2Qow6wyOAubs1GFjHVW8q/y9ldPyvxCHDzJg==\"]",
        "REALTIMEKIT_ACCOUNT_ID": "f50cbb237cd6f0ab48cc3679f727d132",
        "REALTIMEKIT_APP_ID": "df0175c0-6741-43ca-ad7e-a8f89cab3951",
        "REALTIMEKIT_WEBHOOK_PUBLIC_KEY": "-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAqw8f8Gu20kj0k85HuM89
YH6E8rbQhZKgR2GRZt8PUlFowD5XYPQV8jaz3BHNJqzkkrLHaQM6snEEggtcoDH8
nzw7IIwW4MxDuxGXPG3v83301k4xkiZkH2F6moKr4LptTcPDJYTzKCuzCsihMel9
rWVkk7Po3oGW+f3UQ72alNkyxr2ZsVmC63Csg/b4N9N771cm8JrVReCTCe46g1ce
YT+0+ef8j0TNNzg7XdD0U1oxgM9W0Z6ckCRi76XDjWABnWM0GijsJrDQ1SzTiu1u
L30rSQz/w6E6HZeo5BX84w0JIb50qdCKt8zAyUFZyBv7WnxyiwyXuYcPvD/OdEwv
fQIDAQAB
-----END PUBLIC KEY-----",
        "VOICE_AGENT_NAME": "Krude",
        "AGENTS_URL": "https://agents-staging.oryxa.in"
      },
      "routes": [{ "pattern": "edge-staging.oryxa.in", "custom_domain": true }]
    }
  }
}
