# The app calls every service under /v1 on its own origin. `pnpm dev` proxies
# those paths to the services below; a deployment's edge must route them the
# same way. Set VITE_API_URL only to send API calls to a different origin.
AUTH_SERVICE_URL=http://localhost:8080
BILLING_SERVICE_URL=http://localhost:8081
TEAMS_SERVICE_URL=http://localhost:8083
FILES_SERVICE_URL=http://localhost:8085
CONNECTIONS_SERVICE_URL=http://localhost:8086
