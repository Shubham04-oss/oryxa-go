# The app calls every service under /v1 on its own origin. `pnpm dev` proxies
# those paths to the oryxa process below; a deployment's edge must send them to
# it the same way. Set VITE_API_URL only to send API calls to a different origin.
ORYXA_URL=http://localhost:8080

# For a local Cognito demo pool without a Google identity provider, hide the
# Google option and point signup to the local Mailpit inbox.
# VITE_AUTH_PASSWORD_ONLY=true
