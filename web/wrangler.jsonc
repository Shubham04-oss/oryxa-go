{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-weirdly-odd-web",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "vars": {
    "ORYXA_API_ORIGIN": "http://localhost:8080"
  },
  "durable_objects": {
    "bindings": [{ "name": "ThreadChatAgent", "class_name": "ThreadChatAgent" }]
  },
  "migrations": [{ "tag": "thread-chat-v1", "new_sqlite_classes": ["ThreadChatAgent"] }],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  // The production deployment, which deploy/scripts/web.sh builds with
  // CLOUDFLARE_ENV=production. OpenTofu routes app.oryxa.in/* to it, except
  // /v1/*, which Cloudflare sends through a tunnel to the API; it is reached
  // nowhere else.
  "env": {
    "production": {
      "name": "oryxa-production-web",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ORYXA_API_ORIGIN": "https://api.oryxa.in"
      },
      "durable_objects": {
        "bindings": [{ "name": "ThreadChatAgent", "class_name": "ThreadChatAgent" }]
      },
      "migrations": [{ "tag": "thread-chat-v1", "new_sqlite_classes": ["ThreadChatAgent"] }]
    }
  }
}
