{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "oryxa",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "set -a && . ./.env && exec go run ./cmd/oryxa"],
      "port": 8080
    },
    {
      "name": "primary-devui",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "set -a && . ./.env && go build -o agents/primary/bin/devui ./agents/primary/cmd/devui && exec agents/primary/bin/devui"
      ],
      "port": 8087
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "web", "dev"],
      "port": 3000
    }
  ]
}
